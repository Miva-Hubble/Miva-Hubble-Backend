PORT=7292
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@your-region.pooler.supabase.com:6543/postgres
host:your-region.pooler.supabase.com

port:6543

database:postgres

user:postgres.your-project-ref


# JWT Secrets
ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret

# Admin JWT Secrets (kept separate from student secrets on purpose)
ADMIN_ACCESS_TOKEN_SECRET=your-admin-access-token-secret
ADMIN_REFRESH_TOKEN_SECRET=your-admin-refresh-token-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-url.railway.app/api/auth/google/callback

# Frontend URLs (comma-separated)
FRONTEND_URL=https://miva-hubble.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,https://miva-hubble.vercel.app

# Dev-only: set to "true" on Render/staging to enable GET /api/auth/debug/token
ENABLE_DEBUG_TOKEN=false

# Supabase Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key bypasses Row Level Security — server-side only, never ship to a client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=resources
# Separate public bucket for student profile pictures (avatars).
SUPABASE_PROFILE_IMAGES_BUCKET=profile-images

# ─────────────────────────────────────────────────────────────────────────────
# Notification Engine (Upstash Redis + BullMQ + Resend)
# ─────────────────────────────────────────────────────────────────────────────

# Upstash Redis — used as BullMQ job queue transport (NOT local Redis)
# Get this from: https://console.upstash.com → Redis → Connect → Node.js (ioredis)
# Must use the rediss:// (TLS) scheme for Upstash production URLs
UPSTASH_REDIS_URL=rediss://default:your-upstash-token@your-instance.upstash.io:6379

# Resend — primary transactional email provider
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# The "From" address Resend uses when dispatching notification emails
# Must match a verified domain in your Resend account
# Format: "Display Name <email@yourdomain.com>"
RESEND_FROM_EMAIL=Miva Hubble <noreply@miva.edu.ng>

# Set to "true" to prevent the BullMQ worker from starting (e.g. for local testing without Redis)
DISABLE_NOTIFICATION_WORKER=false

# ─────────────────────────────────────────────────────────────────────────────
# SMTP (Legacy — kept for reference only. Replaced by Resend for notifications)
# ─────────────────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=your-email@gmail.com
SUPABASE_STUDENT_RESOURCES_BUCKET=student-resources