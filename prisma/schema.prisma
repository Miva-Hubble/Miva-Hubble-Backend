generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

enum LoginProvider {
  GOOGLE
  NORMAL

  @@schema("public")
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@schema("public")
}

enum PreferredMode {
  ANONYMOUS
  IDENTIFIED

  @@schema("public")
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@schema("public")
}

enum AdminLoginEventType {
  SUCCESS
  FAILED_NOT_FOUND
  FAILED_PASSWORD
  FAILED_STATUS
  FAILED_LOCKED

  @@schema("public")
}

enum BookType {
  TEXTBOOK
  PAST_QUESTION
  STUDY_GUIDE
  REFERENCE

  @@schema("public")
}

enum BookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("public")
}

// Mirrors ALLOWED_UPLOAD_MIME_TYPES in src/schemas/storage.schema.ts — every
// entry there must map to a member here (see storageService.deriveFileFormat).
enum FileFormat {
  PDF
  EPUB
  DOC
  DOCX

  @@schema("public")
}

// ---------------------------------------------------------------------------
// Student-submitted resources (separate domain from the admin-curated Book
// library above — do not reuse BookStatus/BookType for these).
// ---------------------------------------------------------------------------

enum StudentResourceStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED

  @@schema("public")
}

enum StudentResourceType {
  NOTE
  PAST_QUESTION
  STUDY_GUIDE
  REFERENCE

  @@schema("public")
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String  @unique
  name     String
  password String?

  googleId           String? @unique
  picture            String?
  profilePicturePath String?

  last_login_with LoginProvider?
  last_login_at   DateTime?

  email_verified    Boolean   @default(false)
  email_verified_at DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otps                   Otp[]
  onboarding             Onboarding?
  files                  UserFile[]
  notificationRecipients NotificationRecipient[]
  bookDownloads          BookDownload[]
  bookViews              BookView[]
  studentResources       StudentResource[]
  dailyGoals             DailyGoal[]
  progression            UserProgression?

  @@schema("public")
}

model Otp {
  id        String   @id @default(cuid())
  code      String
  type      OtpType
  expiresAt DateTime
  used      Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@schema("public")
}

model Onboarding {
  id            String        @id @default(cuid())
  level         String
  department    String
  goals         String[]
  preferredMode PreferredMode @default(ANONYMOUS)
  completedAt   DateTime      @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// ---------------------------------------------------------------------------
// Admin Auth
// ---------------------------------------------------------------------------

model Admin {
  id       String      @id @default(cuid())
  name     String
  email    String      @unique
  password String
  status   AdminStatus @default(ACTIVE)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions                 AdminSession[]
  loginEvents              AdminLoginEvent[]
  notificationCampaigns    NotificationCampaign[]
  reviewedStudentResources StudentResource[]

  @@schema("public")
}

model AdminSession {
  id               String    @id @default(cuid())
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@schema("public")
}

model AdminLoginEvent {
  id        String              @id @default(cuid())
  email     String
  type      AdminLoginEventType
  ip        String?
  userAgent String?
  createdAt DateTime            @default(now())

  adminId String?
  admin   Admin?  @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([email])
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Storage: private student files + admin-curated library books
// ---------------------------------------------------------------------------

// A private file owned by a single student. `storageObjectId` points at the
// row Supabase Storage itself created in `storage.objects` for the physical
// upload (see the custom SQL migration for the cross-schema FK).
model UserFile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageObjectId String   @unique @map("storage_object_id") @db.Uuid
  customLabel     String?  @map("custom_label")
  isArchived      Boolean  @default(false) @map("is_archived")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_files")
  @@schema("public")
}

// An admin-curated library resource. Targeting fields (level/department/tags)
// drive the personalized feed in StorageService.getPersonalizedFeed.
model Book {
  id              String     @id @default(uuid()) @db.Uuid
  storageObjectId String     @unique @map("storage_object_id") @db.Uuid
  title           String
  author          String
  description     String?
  level           String // Level100-Level500, or "All"
  department      String // e.g. "Computer Science", or "All"
  bookType        BookType   @map("book_type")
  fileFormat      FileFormat @map("file_format") // Derived server-side from the uploaded file's extension — never client-supplied (see StorageService.deriveFileFormat)
  // Optional cover image stored in the public book-covers bucket. Null when
  // admin didn't supply a cover — frontend falls back to a department icon.
  coverImageUrl   String?    @map("cover_image_url")
  status          BookStatus @default(DRAFT)
  tags            String[]   @default([])
  downloadCount   Int        @default(0) @map("download_count")
  previewCount    Int        @default(0) @map("preview_count")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  downloads BookDownload[]
  views     BookView[]

  @@index([status, downloadCount(sort: Desc)])
  @@index([status, previewCount(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("books")
  @@schema("public")
}

// Tracks unique user previews/views per book to prevent view count inflation.
model BookView {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  bookId       String   @map("book_id") @db.Uuid
  viewedAt     DateTime @default(now()) @map("viewed_at")
  lastViewedAt DateTime @updatedAt @map("last_viewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("book_views")
  @@schema("public")
}

// Tracks unique user downloads per book to prevent duplicate download count inflation.
model BookDownload {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id")
  bookId           String   @map("book_id") @db.Uuid
  downloadedAt     DateTime @default(now()) @map("downloaded_at")
  lastDownloadedAt DateTime @updatedAt @map("last_downloaded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("book_downloads")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Student-submitted resources, daily goals & rank progression
//
// Accounting model: DailyGoal is a container, never a progress counter.
// A ResourceContribution is the only thing that links one APPROVED
// StudentResource to one DailyGoal, and it is the source of truth for
// "is today's goal complete" (3 active, non-revoked contributions for that
// day) and for "how many resources has this student had approved" overall.
// UserProgression is a denormalized snapshot for cheap reads (profile
// pages, leaderboards) — it is derived from ResourceContribution rows, not
// the other way around, and must stay reconcilable from them.
// ---------------------------------------------------------------------------

// A single academic resource a student submits for admin review. Physically
// never hard-deleted once it has an attached ResourceContribution — see
// ResourceContribution below for why (immutable accounting trail).
model StudentResource {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @map("user_id")
  // Restrict, not Cascade: cascading here would let PostgreSQL attempt to
  // delete a StudentResource that still has a Restrict-protected
  // ResourceContribution, which fails at the DB level once a user has any
  // accounting history. A user with progression history is therefore not
  // physically deletable at all — account removal for such users must be
  // implemented as anonymization/deactivation, not a destructive delete.
  user            User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  storageObjectId String @unique @map("storage_object_id") @db.Uuid

  // File metadata captured once at draft creation, from the same
  // storage.objects verification StudentResourceService.createDraft already
  // performs — not re-derived on every read. storagePath in particular is
  // an INTERNAL-ONLY field: never serialize it in an API response. Clients
  // must always be issued a short-lived signed URL (see storage routes)
  // instead of the raw path — see StudentResourceService.toPublicResource,
  // which every controller response is required to pass through.
  storagePath String @map("storage_path")
  mimeType    String @map("mime_type")
  sizeBytes   Int    @map("size_bytes")

  title       String
  description String?
  level       String
  department  String
  courseCode  String  @map("course_code")
  courseTitle String  @map("course_title")

  resourceType StudentResourceType   @map("resource_type")
  fileFormat   FileFormat            @map("file_format")
  status       StudentResourceStatus @default(DRAFT)

  // Nullable + SetNull, matching the Admin-authored-content pattern already
  // used by NotificationCampaign.createdByAdmin — a removed reviewer admin
  // must never block deleting that admin's account, and the review decision
  // itself (status/reviewedAt/rejectionReason) survives independently of who
  // made it.
  reviewedByAdminId String?   @map("reviewed_by_admin_id")
  reviewedByAdmin   Admin?    @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime? @map("reviewed_at")
  // Distinct from reviewedAt because reviewedAt fires on rejection too —
  // this is set only on approval, and is what reconstructing the Lagos
  // contribution date (and any future audit of "when did this actually
  // become an approved resource") must key off instead.
  approvedAt        DateTime? @map("approved_at")
  rejectionReason   String?   @map("rejection_reason")

  submittedAt DateTime @default(now()) @map("submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  contribution ResourceContribution?

  // Supports the six-submission-per-day rate limit check (COUNT ... WHERE
  // userId = ? AND submittedAt >= today).
  @@index([userId, submittedAt])
  // Supports the admin review queue (WHERE status = PENDING_REVIEW ORDER BY submittedAt).
  @@index([status, submittedAt])
  // Supports eventual student-resource discovery filtered by targeting + status.
  @@index([level, department, status])
  @@map("student_resources")
  @@schema("public")
}

// A per-student, per-day accounting container. Deliberately holds no
// progress percentage or manually-incremented counter — "how many
// contributions today" and "is this goal complete" are always derived by
// counting this row's active (non-revoked) ResourceContribution children,
// never stored here. That's what keeps the count impossible to drift from
// the underlying approved resources.
model DailyGoal {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  // Restrict, matching StudentResource.user — same reason: a DailyGoal with
  // Restrict-protected ResourceContribution children can't be cascaded
  // through, so the parent User can't be either.
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  activityDate DateTime @map("activity_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contributions ResourceContribution[]

  // Non-negotiable: exactly one goal container per student per calendar day.
  @@unique([userId, activityDate])
  // Supports admin reporting (e.g. "how many goals were completed on date X").
  @@index([activityDate])
  @@map("daily_goals")
  @@schema("public")
}

// The immutable accounting link between one approved StudentResource and
// the DailyGoal it counted toward. This row, not a counter anywhere else,
// is the ledger entry: a day's contribution count and a student's lifetime
// approved-resource count are both derived by counting these (excluding
// revoked ones), which is what makes UserProgression reconcilable rather
// than an independent, driftable source of truth.
model ResourceContribution {
  id                String          @id @default(uuid()) @db.Uuid
  studentResourceId String          @unique @map("student_resource_id") @db.Uuid
  // Restrict, not Cascade: a StudentResource with a contribution must never
  // be physically deletable — archive or revoke it instead, preserving the
  // audit trail this table exists to guarantee.
  studentResource   StudentResource @relation(fields: [studentResourceId], references: [id], onDelete: Restrict)

  dailyGoalId String    @map("daily_goal_id") @db.Uuid
  // Restrict, not Cascade: a DailyGoal must never disappear out from under
  // contributions that still reference it.
  dailyGoal   DailyGoal @relation(fields: [dailyGoalId], references: [id], onDelete: Restrict)

  countedAt        DateTime  @default(now()) @map("counted_at")
  // A decision reversal (e.g. a resource is retroactively disqualified)
  // is recorded here, never by deleting the row — revokedAt/revocationReason
  // preserve why a contribution stopped counting instead of erasing that it
  // ever existed.
  revokedAt        DateTime? @map("revoked_at")
  revocationReason String?   @map("revocation_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // studentResourceId already has an implicit index via its own @unique;
  // dailyGoalId does not, and every "how many active contributions for this
  // goal" / "is this goal complete" read filters on it.
  @@index([dailyGoalId])
  @@map("resource_contributions")
  @@schema("public")
}

// Fixed reference table of the ten progression ranks (Novice → Ultimate),
// seeded once and rarely written to afterward — a cuid() primary key (like
// User/Admin) rather than a uuid() suits stable, hand-seeded reference rows
// better than the random uuid() used for high-volume domain tables above.
model RankDefinition {
  id                       String @id @default(cuid())
  level                    Int    @unique
  name                     String @unique
  minimumApprovedResources Int    @unique @map("minimum_approved_resources")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userProgressions UserProgression[]

  @@map("rank_definitions")
  @@schema("public")
}

// Query-optimized snapshot of a student's progression, not the accounting
// source of truth — that's ResourceContribution. The application updates
// this transactionally alongside new contributions and must be able to
// fully reconcile/rebuild it from contribution rows if it ever drifts.
model UserProgression {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rankId String         @map("rank_id")
  // Restrict: a rank definition must never be deletable while a student
  // snapshot still points at it.
  rank   RankDefinition @relation(fields: [rankId], references: [id], onDelete: Restrict)

  approvedResourceCount Int       @default(0) @map("approved_resource_count")
  currentStreak         Int       @default(0) @map("current_streak")
  longestStreak         Int       @default(0) @map("longest_streak")
  lastCompletedGoalDate DateTime? @map("last_completed_goal_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // userId already has an implicit index via its own @unique; rankId does
  // not, and any "how many students are at rank X" / rank-based leaderboard
  // read filters on it.
  @@index([rankId])
  @@map("user_progressions")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Notifications Engine State & Audit Persistence
// ---------------------------------------------------------------------------

enum NotificationStatus {
  PENDING
  QUEUED
  PROCESSING
  DELIVERED
  FAILED

  @@schema("public")
}

enum NotificationChannel {
  EMAIL
  IN_APP

  @@schema("public")
}

enum OutboxJobStatus {
  PENDING
  COMPLETED
  FAILED

  @@schema("public")
}

model OutboxJob {
  id         String          @id @default(cuid())
  campaignId String          @map("campaign_id") @db.Uuid
  payload    Json
  status     OutboxJobStatus @default(PENDING)
  attempts   Int             @default(0)
  lastError  String?         @map("last_error")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  campaign NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("outbox_jobs")
  @@schema("public")
}

enum NotificationType {
  BROADCAST
  TRANSACTIONAL
  SYSTEM

  @@schema("public")
}

enum CampaignStatus {
  DRAFT
  SCHEDULING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELED

  @@schema("public")
}

enum DeliveryEventType {
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
  RETRYING

  @@schema("public")
}

model NotificationCampaign {
  id             String           @id @default(uuid()) @db.Uuid
  type           NotificationType @default(BROADCAST)
  idempotencyKey String?          @unique @map("idempotency_key")
  title          String
  // The literal email Subject header sent to recipients (see
  // NotificationService.dispatchNotification / notification.worker.ts).
  // Nullable ONLY for backward compatibility with campaigns created before
  // this column existed — those relied on `title` doubling as the subject.
  // Every campaign created going forward always sets this explicitly;
  // readers must fall back to `title` when this is null (see
  // notification.service.ts / notification-campaign.repository.ts).
  // `title` itself is kept as a separate field on purpose — it's the
  // durable admin-facing campaign label; `subject` is what the recipient
  // actually sees. They hold the same value today because the API doesn't
  // yet expose a distinct "campaign name" input, but the columns are no
  // longer conflated at the schema level, so that can change without
  // another migration.
  subject        String?
  message        String           @db.Text

  targetLevels      String[] @default([])
  targetDepartments String[] @default([])

  // Which channel this campaign was (or will be) dispatched through.
  // Defaults to EMAIL because IN_APP delivery isn't implemented yet (see
  // notification.validation.ts / notification.worker.ts, which hardcodes
  // the Resend/email provider) — every campaign today is implicitly
  // email-only. Recording it explicitly here, instead of only on
  // NotificationJobData (transient queue payload, never persisted), is what
  // makes "was this campaign email or in-app" a queryable fact instead of
  // something inferred after the fact from recipient delivery events.
  channel NotificationChannel @default(EMAIL)

  status         CampaignStatus @default(DRAFT)
  recipientCount Int            @default(0) @map("recipient_count")
  // Preserves the bounded, validated metadata capability from Phase 0
  // hardening (#7) — the flat Notification model had this column, the new
  // campaign model needs it too so nothing silently regresses.
  metadata       Json?          @default("{}")

  // Nullable + SetNull, matching Notification.createdByAdminId and
  // AdminLoginEvent.adminId — a removed/rogue admin account must always be
  // safely deletable without being blocked by campaigns they once sent.
  // The *application* still requires a known admin at creation time (see
  // NotificationService.dispatchNotification's guard clause) — this only
  // relaxes what happens to historical campaigns after that admin is gone.
  createdByAdminId String? @map("created_by_admin_id")
  createdByAdmin   Admin?  @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipients NotificationRecipient[]
  outboxJobs OutboxJob[]

  @@map("notification_campaigns")
  @@schema("public")
}

model NotificationRecipient {
  id         String               @id @default(uuid()) @db.Uuid
  campaignId String               @map("campaign_id") @db.Uuid
  campaign   NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Nullable + SetNull so recipient and delivery history survive a student
  // account deletion, matching the Notification.userId and AdminLoginEvent pattern.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  email             String
  status            NotificationStatus @default(PENDING)
  attempts          Int                @default(0)
  lastError         String?            @map("last_error")
  providerMessageId String?            @map("provider_message_id")
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  // Set on every status transition (PENDING -> QUEUED -> PROCESSING -> DELIVERED/FAILED)
  // via Prisma's @updatedAt. Lets an operator answer "how long has this recipient
  // been stuck in PROCESSING" directly from the row instead of reconstructing the
  // timeline from notification_delivery_events.
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  deliveryEvents NotificationDeliveryEvent[]

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@map("notification_recipients")
  @@schema("public")
}

model NotificationDeliveryEvent {
  id                      String                @id @default(uuid()) @db.Uuid
  notificationRecipientId String                @map("notification_recipient_id") @db.Uuid
  // Restrict deletion of recipients when delivery events exist to guarantee an immutable audit trail
  recipient               NotificationRecipient @relation(fields: [notificationRecipientId], references: [id], onDelete: Restrict)

  event             DeliveryEventType
  provider          String?
  providerMessageId String?           @map("provider_message_id")
  metadata          Json?             @default("{}")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([notificationRecipientId])
  @@map("notification_delivery_events")
  @@schema("public")
}
