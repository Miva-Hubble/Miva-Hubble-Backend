generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

enum LoginProvider {
  GOOGLE
  NORMAL

  @@schema("public")
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@schema("public")
}

enum PreferredMode {
  ANONYMOUS
  IDENTIFIED

  @@schema("public")
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@schema("public")
}

enum AdminLoginEventType {
  SUCCESS
  FAILED_NOT_FOUND
  FAILED_PASSWORD
  FAILED_STATUS
  FAILED_LOCKED

  @@schema("public")
}

enum BookType {
  TEXTBOOK
  PAST_QUESTION
  STUDY_GUIDE
  REFERENCE

  @@schema("public")
}

enum BookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("public")
}

// Mirrors ALLOWED_UPLOAD_MIME_TYPES in src/schemas/storage.schema.ts — every
// entry there must map to a member here (see storageService.deriveFileFormat).
enum FileFormat {
  PDF
  EPUB
  DOC
  DOCX

  @@schema("public")
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String  @unique
  name     String
  password String?

  googleId           String? @unique
  picture            String?
  profilePicturePath String?

  last_login_with LoginProvider?
  last_login_at   DateTime?

  email_verified    Boolean   @default(false)
  email_verified_at DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otps                   Otp[]
  onboarding             Onboarding?
  files                  UserFile[]
  notificationRecipients NotificationRecipient[]
  bookDownloads          BookDownload[]
  bookViews              BookView[]

  @@schema("public")
}

model Otp {
  id        String   @id @default(cuid())
  code      String
  type      OtpType
  expiresAt DateTime
  used      Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@schema("public")
}

model Onboarding {
  id            String        @id @default(cuid())
  level         String
  department    String
  goals         String[]
  preferredMode PreferredMode @default(ANONYMOUS)
  completedAt   DateTime      @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// ---------------------------------------------------------------------------
// Admin Auth
// ---------------------------------------------------------------------------

model Admin {
  id       String      @id @default(cuid())
  name     String
  email    String      @unique
  password String
  status   AdminStatus @default(ACTIVE)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions              AdminSession[]
  loginEvents           AdminLoginEvent[]
  notificationCampaigns NotificationCampaign[]

  @@schema("public")
}

model AdminSession {
  id               String    @id @default(cuid())
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@schema("public")
}

model AdminLoginEvent {
  id        String              @id @default(cuid())
  email     String
  type      AdminLoginEventType
  ip        String?
  userAgent String?
  createdAt DateTime            @default(now())

  adminId String?
  admin   Admin?  @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([email])
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Storage: private student files + admin-curated library books
// ---------------------------------------------------------------------------

// A private file owned by a single student. `storageObjectId` points at the
// row Supabase Storage itself created in `storage.objects` for the physical
// upload (see the custom SQL migration for the cross-schema FK).
model UserFile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageObjectId String   @unique @map("storage_object_id") @db.Uuid
  customLabel     String?  @map("custom_label")
  isArchived      Boolean  @default(false) @map("is_archived")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_files")
  @@schema("public")
}

// An admin-curated library resource. Targeting fields (level/department/tags)
// drive the personalized feed in StorageService.getPersonalizedFeed.
model Book {
  id              String     @id @default(uuid()) @db.Uuid
  storageObjectId String     @unique @map("storage_object_id") @db.Uuid
  title           String
  author          String
  description     String?
  level           String // Level100-Level500, or "All"
  department      String // e.g. "Computer Science", or "All"
  bookType        BookType   @map("book_type")
  fileFormat      FileFormat @map("file_format") // Derived server-side from the uploaded file's extension — never client-supplied (see StorageService.deriveFileFormat)
  // Optional cover image stored in the public book-covers bucket. Null when
  // admin didn't supply a cover — frontend falls back to a department icon.
  coverImageUrl   String?    @map("cover_image_url")
  status          BookStatus @default(DRAFT)
  tags            String[]   @default([])
  downloadCount   Int        @default(0) @map("download_count")
  previewCount    Int        @default(0) @map("preview_count")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  downloads       BookDownload[]
  views           BookView[]

  @@index([status, downloadCount(sort: Desc)])
  @@index([status, previewCount(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("books")
  @@schema("public")
}

// Tracks unique user previews/views per book to prevent view count inflation.
model BookView {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  bookId       String   @map("book_id") @db.Uuid
  viewedAt     DateTime @default(now()) @map("viewed_at")
  lastViewedAt DateTime @updatedAt @map("last_viewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("book_views")
  @@schema("public")
}

// Tracks unique user downloads per book to prevent duplicate download count inflation.
model BookDownload {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id")
  bookId           String   @map("book_id") @db.Uuid
  downloadedAt     DateTime @default(now()) @map("downloaded_at")
  lastDownloadedAt DateTime @updatedAt @map("last_downloaded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("book_downloads")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Notifications Engine State & Audit Persistence
// ---------------------------------------------------------------------------

enum NotificationStatus {
  PENDING
  QUEUED
  PROCESSING
  DELIVERED
  FAILED

  @@schema("public")
}

enum NotificationChannel {
  EMAIL
  IN_APP

  @@schema("public")
}

enum OutboxJobStatus {
  PENDING
  COMPLETED
  FAILED

  @@schema("public")
}

model OutboxJob {
  id         String          @id @default(cuid())
  campaignId String          @map("campaign_id") @db.Uuid
  payload    Json
  status     OutboxJobStatus @default(PENDING)
  attempts   Int             @default(0)
  lastError  String?         @map("last_error")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  campaign NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("outbox_jobs")
  @@schema("public")
}

enum NotificationType {
  BROADCAST
  TRANSACTIONAL
  SYSTEM

  @@schema("public")
}

enum CampaignStatus {
  DRAFT
  SCHEDULING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELED

  @@schema("public")
}

enum DeliveryEventType {
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
  RETRYING

  @@schema("public")
}

model NotificationCampaign {
  id             String           @id @default(uuid()) @db.Uuid
  type           NotificationType @default(BROADCAST)
  idempotencyKey String?          @unique @map("idempotency_key")
  title          String
  // The literal email Subject header sent to recipients (see
  // NotificationService.dispatchNotification / notification.worker.ts).
  // Nullable ONLY for backward compatibility with campaigns created before
  // this column existed — those relied on `title` doubling as the subject.
  // Every campaign created going forward always sets this explicitly;
  // readers must fall back to `title` when this is null (see
  // notification.service.ts / notification-campaign.repository.ts).
  // `title` itself is kept as a separate field on purpose — it's the
  // durable admin-facing campaign label; `subject` is what the recipient
  // actually sees. They hold the same value today because the API doesn't
  // yet expose a distinct "campaign name" input, but the columns are no
  // longer conflated at the schema level, so that can change without
  // another migration.
  subject String?
  message String  @db.Text

  targetLevels      String[] @default([])
  targetDepartments String[] @default([])

  // Which channel this campaign was (or will be) dispatched through.
  // Defaults to EMAIL because IN_APP delivery isn't implemented yet (see
  // notification.validation.ts / notification.worker.ts, which hardcodes
  // the Resend/email provider) — every campaign today is implicitly
  // email-only. Recording it explicitly here, instead of only on
  // NotificationJobData (transient queue payload, never persisted), is what
  // makes "was this campaign email or in-app" a queryable fact instead of
  // something inferred after the fact from recipient delivery events.
  channel NotificationChannel @default(EMAIL)

  status         CampaignStatus @default(DRAFT)
  recipientCount Int            @default(0) @map("recipient_count")
  // Preserves the bounded, validated metadata capability from Phase 0
  // hardening (#7) — the flat Notification model had this column, the new
  // campaign model needs it too so nothing silently regresses.
  metadata       Json?          @default("{}")

  // Nullable + SetNull, matching Notification.createdByAdminId and
  // AdminLoginEvent.adminId — a removed/rogue admin account must always be
  // safely deletable without being blocked by campaigns they once sent.
  // The *application* still requires a known admin at creation time (see
  // NotificationService.dispatchNotification's guard clause) — this only
  // relaxes what happens to historical campaigns after that admin is gone.
  createdByAdminId String? @map("created_by_admin_id")
  createdByAdmin   Admin?  @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipients NotificationRecipient[]
  outboxJobs OutboxJob[]

  @@map("notification_campaigns")
  @@schema("public")
}

model NotificationRecipient {
  id         String               @id @default(uuid()) @db.Uuid
  campaignId String               @map("campaign_id") @db.Uuid
  campaign   NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Nullable + SetNull so recipient and delivery history survive a student
  // account deletion, matching the Notification.userId and AdminLoginEvent pattern.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  email             String
  status            NotificationStatus @default(PENDING)
  attempts          Int                @default(0)
  lastError         String?            @map("last_error")
  providerMessageId String?            @map("provider_message_id")
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  // Set on every status transition (PENDING -> QUEUED -> PROCESSING -> DELIVERED/FAILED)
  // via Prisma's @updatedAt. Lets an operator answer "how long has this recipient
  // been stuck in PROCESSING" directly from the row instead of reconstructing the
  // timeline from notification_delivery_events.
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  deliveryEvents NotificationDeliveryEvent[]

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@map("notification_recipients")
  @@schema("public")
}

model NotificationDeliveryEvent {
  id                      String                @id @default(uuid()) @db.Uuid
  notificationRecipientId String                @map("notification_recipient_id") @db.Uuid
  // Restrict deletion of recipients when delivery events exist to guarantee an immutable audit trail
  recipient               NotificationRecipient @relation(fields: [notificationRecipientId], references: [id], onDelete: Restrict)

  event             DeliveryEventType
  provider          String?
  providerMessageId String?           @map("provider_message_id")
  metadata          Json?             @default("{}")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([notificationRecipientId])
  @@map("notification_delivery_events")
  @@schema("public")
}
