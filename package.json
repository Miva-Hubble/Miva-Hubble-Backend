{
  "name": "miva_hubble_server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:dev": "dotenv -e .env -e .env.dev -- tsx watch src/index.ts",
    "dev:development": "dotenv -e .env.development -- pnpm dev",
    "dev:production": "dotenv -e .env.production -- pnpm dev",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "check:onboarding": "node scripts/check-onboarding-api.mjs",
    "test:onboarding": "node scripts/test-onboarding-live.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "seed:ranks": "dotenv -e .env.development -- tsx scripts/seed-rank-definitions.ts",
    "fix:book-targeting": "node scripts/normalize-book-targeting.mjs",
    "test:welcome-email": "tsx scripts/test-welcome-email.ts",
    "test:gate6": "dotenv -e .env.development -- tsx scripts/test-student-resources-e2e.ts",
    "test:gate7": "dotenv -e .env.development -- tsx scripts/test-gate7-e2e.ts",
    "test:gate8": "dotenv -e .env.development -- tsx scripts/test-gate8-progression.ts",
    "test:gate9": "dotenv -e .env.development -- tsx scripts/test-gate9-progress-endpoint.ts",
    "test:gate10": "dotenv -e .env.development -- tsx scripts/test-gate10-admin-progression-e2e.ts",
    "test:gate12": "dotenv -e .env.development -- tsx scripts/test-gate12-vault-e2e.ts",
    "test:daily-goal": "pnpm test:gate6 && pnpm test:gate7 && pnpm test:gate8 && pnpm test:gate9 && pnpm test:gate10 && pnpm test:gate12",
    "reconcile:campaigns": "tsx scripts/reconcile-stuck-campaigns.ts",
    "reconcile:progression": "dotenv -e .env.development -- tsx scripts/reconcile-user-progression.ts",
    "reconcile:progression:dry-run": "dotenv -e .env.development -- tsx scripts/reconcile-user-progression.ts --dry-run",
    "reconcile:campaigns:fix": "tsx scripts/reconcile-stuck-campaigns.ts --fix",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^7.0.12",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.16.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^9.0.0",
    "googleapis": "^170.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.17.1",
    "prisma": "^7.8.0",
    "resend": "^6.19.0",
    "sanitize-html": "^2.17.7",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.1",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.14",
    "supabase": "^2.116.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4"
  }
}
